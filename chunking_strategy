import os
import re

# Strategy 1: Fixed-size 
def chunk_text(text, chunk_size=500, overlap=50):
    chunks, start = [], 0
    while start < len(text):
        chunks.append(text[start:start+chunk_size])
        start += chunk_size - overlap
    return chunks


# Strategy 2: Sentence-based
def chunk_by_sentences(text, sentences_per_chunk=5):
    sentences = re.split(r'(?<=[.!?])\s+', text)
    return [" ".join(sentences[i:i+sentences_per_chunk])
            for i in range(0, len(sentences), sentences_per_chunk)]


# Strategy 3: Section-based
def chunk_by_sections(text, separator="\n\n"):
    return [s.strip() for s in text.split(separator) if len(s.strip()) > 50]


# Show chunk counts:
strategies = {
    "fixed_500":  lambda t: chunk_text(t, chunk_size=500, overlap=50),
    "sentence_5": lambda t: chunk_by_sentences(t, sentences_per_chunk=5),
    "section":    lambda t: chunk_by_sections(t),
}
for name, chunker in strategies.items():
    chunks = []
    for fn in os.listdir("files"):
        with open(f"files/{fn}") as f: text = f.read()
        chunks.extend(chunker(text))
    print(f"{name}: {len(chunks)} chunks")
